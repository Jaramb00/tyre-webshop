{
  "ConnectionStrings": {
    "DefaultConnection": "Host=postgres;Port=5432;Database=smartcommerce;Username=postgres;Password=__SET_VIA_ENV__",
    "Redis": "redis:6379"
  },
  "Jwt": {
    "SecretKey": "__SET_VIA_ENV__ConnectionStrings__Jwt__SecretKey_min32chars__",
    "Issuer": "SmartCommerce",
    "Audience": "SmartCommerce",
    "AccessTokenExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 30
  },
  "Stripe": {
    "SecretKey": "sk_test_CHANGE_ME",
    "PublishableKey": "pk_test_CHANGE_ME",
    "WebhookSecret": "whsec_CHANGE_ME"
  },
  "SendGrid": {
    "ApiKey": "SG.CHANGE_ME",
    "FromEmail": "noreply@smartcommerce.com",
    "FromName": "SmartCommerce"
  },
  "OpenWeather": {
    "ApiKey": "CHANGE_ME",
    "BaseUrl": "https://api.openweathermap.org/data/2.5"
  },
  "ExchangeRate": {
    "ApiKey": "CHANGE_ME",
    "BaseUrl": "https://v6.exchangerate-api.com/v6"
  },
  "Frontend": {
    "Url": "http://localhost:3000"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithEnvironmentName" ]
  },
  "AllowedHosts": "*"
}
